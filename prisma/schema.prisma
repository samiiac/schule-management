generator client {
  provider = "prisma-client-js"            
  output   = "../src/generated/prisma"  
}

datasource db {
  provider = "postgresql"
}

enum UserRole{
  ADMIN
  STUDENT
  INSTRUCTOR
  PARENT
}

enum Grade{
  A
  B
  C
  D
  UG
}

model User {
  id       String      @id @default(uuid())
  firstName   String      
  lastName   String?
  passwordHash String
  email      String          @unique
  role       UserRole        @default(STUDENT)
  isActive   Boolean         @default(true)
  passwordChangeRequired Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  refreshTokens  RefreshToken[]
  studentInfo StudentInfo? 
  instructorInfo InstructorInfo?
  parentInfo     ParentInfo?

}

model RefreshToken {
  id        String     @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  createdAt DateTime @default(now())
}

model StudentInfo {
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gpa          Float    @default(0.0)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  parentId     String?
  parent       ParentInfo? @relation(fields: [parentId], references: [userId],onDelete:SetNull)
  enrollments  Enrollment[]
}


model InstructorInfo {
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  courses      Course[]
}

//instrutcor and courses many to many?

model ParentInfo {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  children  StudentInfo[]
}

model Department{
  id   String   @id @default(uuid())
  name  String  @unique
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  isActive   Boolean   @default(true)

  instructors   InstructorInfo[]
  courses       Course[]
  students      StudentInfo[]
 
}

model Course {
  id            String   @id @default(uuid())
  name          String   
  totalSeats    Int
  creditHours   Int
  enrolledCount Int       @default(0)
  departmentId  String
  isActive      Boolean   @default(true)
  department    Department @relation(fields: [departmentId], references: [id])
  instructorId  String?
  instructor    InstructorInfo? @relation(fields: [instructorId], references: [userId],onDelete:SetNull)
  enrollments   Enrollment[]
}

model Enrollment{
  id    String    @id @default(uuid())
  studentId  String
  studentInfo    StudentInfo  @relation(fields:[studentId],references:[userId])
  courseId String
  course  Course    @relation(fields:[courseId],references:[id])
  grade   Grade     @default(UG)
  enrolledAt DateTime @default(now())
  @@unique([studentId,courseId])
} 
