datasource db {
  provider = "postgresql"
  url      = "" 
}

generator client {
  provider = "prisma-client-js"
}

model Class {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  students Student[]
}

model Student {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String
  lastName  String
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())
}
